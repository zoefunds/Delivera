# Copy to .env and fill in. NEVER commit real values.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivera
REDIS_URL=rediss://default:CHANGE_ME@your-instance.upstash.io:6379
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random
BREVO_API_KEY=xkeysib-CHANGE_ME
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Delivera
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=
# Base Sepolia payment layer (contracts/base/DeliveraEscrow.sol).
# GenLayer only decides milestone/dispute outcomes; real USDC escrow and
# payout are relayed to this contract. See src/services/baseSepolia.ts and
# src/jobs/relay.ts.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DELIVERA_ESCROW_ADDRESS=
# Backend-controlled wallet authorized as the escrow's relayer. Never commit
# a real one — set it in backend/.env (gitignored) or your deploy platform's
# secret store, never in source or chat.
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=
# Tigris (fly storage create fills these)
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
