# Copy to .env and fill in. NEVER commit real values.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivera
REDIS_URL=rediss://default:CHANGE_ME@your-instance.upstash.io:6379
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random
WALLET_MASTER_KEY=CHANGE_ME_at_least_32_characters_long_random
BREVO_API_KEY=xkeysib-CHANGE_ME
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Delivera
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=
# Tigris (fly storage create fills these)
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
