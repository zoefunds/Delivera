# Base Sepolia RPC endpoint (e.g. https://sepolia.base.org, or an Alchemy/Infura URL)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private key of the wallet that will deploy DeliveraEscrow. NEVER commit the
# real value — this file only documents the variable name.
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=

# USDC contract address on Base Sepolia.
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Wallet address of the backend relayer allowed to call releaseMilestone /
# refund / resolveDispute (passed to the constructor at deploy time).
BASE_SEPOLIA_RELAYER_ADDRESS=
